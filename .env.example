# Copia este archivo como .env y rellena tus claves. Nunca subas .env a GitHub.

# Obligatoria para respuestas reales (búsqueda web + explicación). Sin ella: modo demostración.
# Se obtiene en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Recomendada para videos verificados. Google Cloud Console → YouTube Data API v3 → Credenciales → Clave de API
YOUTUBE_API_KEY=

# Opcionales
MODELO=claude-sonnet-5-5
MODELO_RAPIDO=claude-haiku-5-5
BUSQUEDAS_MAX=5
LIMITE_POR_HORA=40
# Lista separada por comas; * permite cualquier origen (necesario para el APK y la app de Windows)
ORIGENES_PERMITIDOS=*
PORT=3000
